# CMake cache preset shared by the iOS build (build-mariadb-ios.sh) and a Linux test build:
# only what TravianZ needs – InnoDB, Aria (system tables), MyISAM/HEAP, no plugins, no client extras.
#   cmake -C ios/mariadb/mariadb-options.cmake …
set(CMAKE_BUILD_TYPE MinSizeRel CACHE STRING "")
set(WITH_UNIT_TESTS OFF CACHE BOOL "")
set(WITH_WSREP OFF CACHE BOOL "")
set(WITH_EMBEDDED_SERVER OFF CACHE BOOL "")
set(WITH_MARIABACKUP OFF CACHE BOOL "")
set(WITHOUT_DYNAMIC_PLUGINS ON CACHE BOOL "")
set(WITH_SAFEMALLOC OFF CACHE BOOL "")
set(WITH_SYSTEMD no CACHE STRING "")
set(WITH_NUMA OFF CACHE BOOL "")
set(WITH_LIBNUMA NO CACHE STRING "")
set(WITH_URING no CACHE STRING "")
set(WITH_LIBAIO OFF CACHE BOOL "")
set(WITH_JEMALLOC no CACHE STRING "")
set(WITH_SSL bundled CACHE STRING "")
set(WITH_ZLIB bundled CACHE STRING "")   # system zlib adds -I<SDK>/usr/include before libc++ headers
set(WITH_INNODB_LZ4 OFF CACHE STRING "")
set(WITH_INNODB_LZO OFF CACHE STRING "")
set(WITH_INNODB_SNAPPY OFF CACHE STRING "")
set(WITH_INNODB_BZIP2 OFF CACHE STRING "")
set(WITH_INNODB_LZMA OFF CACHE STRING "")
set(WITH_ROCKSDB_LZ4 OFF CACHE STRING "")
set(WITH_EXTRA_CHARSETS complex CACHE STRING "")
set(WITHOUT_ABI_CHECK ON CACHE BOOL "")
set(UPDATE_SUBMODULES OFF CACHE BOOL "")
set(ENABLED_PROFILING OFF CACHE BOOL "")
set(SECURITY_HARDENED OFF CACHE BOOL "")
set(MYSQL_MAINTAINER_MODE OFF CACHE STRING "")
foreach(p COLUMNSTORE ROCKSDB MROONGA SPIDER CONNECT S3 OQGRAPH SPHINX TOKUDB FEDERATED FEDERATEDX ARCHIVE
          BLACKHOLE PERFSCHEMA AUTH_GSSAPI AUTH_PAM AUTH_PAM_V1 AUTH_ED25519 AUTH_SOCKET
          HASHICORP_KEY_MANAGEMENT AWS_KEY_MANAGEMENT FILE_KEY_MANAGEMENT EXAMPLE_KEY_MANAGEMENT
          PROVIDER_BZIP2 PROVIDER_LZ4 PROVIDER_LZMA PROVIDER_LZO PROVIDER_SNAPPY CRACKLIB_PASSWORD_CHECK
          SIMPLE_PASSWORD_CHECK FEEDBACK METADATA_LOCK_INFO QUERY_CACHE_INFO QUERY_RESPONSE_TIME LOCALES
          SERVER_AUDIT SQL_ERRLOG WSREP_INFO DISKS AUDIT_NULL DAEMON_EXAMPLE DEBUG_KEY_MANAGEMENT
          EXAMPLE FTEXAMPLE TEST_SQL_DISCOVERY TEST_VERSIONING UNIX_SOCKET_AUTH USER_VARIABLES
          TYPE_TEST FUNC_TEST HANDLERSOCKET THREAD_POOL_INFO PASSWORD_REUSE_CHECK ONLINE_ALTER_LOG
          )
  set(PLUGIN_${p} NO CACHE STRING "")
endforeach()
set(CONC_WITH_SSL NONE CACHE STRING "")
# Connector/C (libmariadb) client plugins use OFF instead of NO
foreach(p AUTH_GSSAPI_CLIENT CLIENT_ED25519 PARSEC)
  set(PLUGIN_${p} OFF CACHE STRING "")
endforeach()
